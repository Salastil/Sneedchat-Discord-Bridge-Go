#Copy or rename this example file to .env 
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
# Get this by right-clicking your Discord profile
DISCORD_PING_USER_ID=your_discord_user_id_here  
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
# Interval between reconnect attempts if connection is lost
RECONNECT_INTERVAL=5
# Media upload backend (currently only litterbox is supported)
MEDIA_UPLOAD_SERVICE=litterbox
# Which room will be bridged, append integer at the end of room name. Current options: general.1, gunt.8, keno-kasino.15, fishtank.16, beauty-parlor.18, sports.19,
SNEEDCHAT_ROOM_ID=1
# Enable logging to bridge.log file for debugging purposes(true/false, default: false)
ENABLE_FILE_LOGGING=false

#Use your Kiwifarm crendeitals for here
#This USER_ID number is in the url when you go to your profile, its required to prevent Discord from echoing your own messages back to you and to allow pings/push notifications work on Discord
# BRIDGE_USER_ID=123456
# BRIDGE_USERNAME=YourBridgeBot
# BRIDGE_PASSWORD=Password

# --- Sneedchat connection (Kiwi Farms side only — Discord and media
# uploads always stay on clearnet regardless of these settings) ---
#
# Set KIWIFARMS_HOST to a .onion address and TOR_SOCKS_PROXY to your local
# Tor SOCKS5 proxy (usually 127.0.0.1:9050) to connect to Sneedchat over
# Tor. Leave both unset to use clearnet kiwifarms.st as before.
# KIWIFARMS_HOST=kiwifarmsaaf4t2h7gc3dfc5ojhmqruw2nit3uejrpiagrxeuxiyxcyd.onion
# KIWIFARMS_SCHEME=https
# TOR_SOCKS_PROXY=127.0.0.1:9050
# Some .onion mirrors serve self-signed certs; set this to skip verification.
# KIWIFARMS_TLS_INSECURE_SKIP_VERIFY=false
# Full WebSocket URL override. Only needed if the .onion mirror's chat
# WebSocket lives at a different host/port than KIWIFARMS_HOST implies
# (defaults to wss://<KIWIFARMS_HOST>:9443/chat.ws — adjust if that port
# isn't reachable on the onion service).
# SNEEDCHAT_WS_URL=wss://kiwifarmsaaf4t2h7gc3dfc5ojhmqruw2nit3uejrpiagrxeuxiyxcyd.onion:9443/chat.ws
